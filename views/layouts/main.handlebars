<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.css">
    {{!-- Fontes da identidade visual: Noto Serif (títulos) e Noto Sans (textos) --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Noto+Serif:ital,wght@0,400;0,500;0,600;1,500;1,600&display=swap">
    {{!-- CSS próprio do site: carregado depois do Bootstrap para poder sobrescrevê-lo --}}
    <link rel="stylesheet" href="/css/libris.css">
    <title>Libris — Leia, avalie, compartilhe</title>
</head>

<body>
    {{!-- Topo da Página --}}
    {{>_navbar}}

    {{!-- Corpo da Página --}}
    <div class="container conteudo-principal mt-5">

        {{#if error}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{else}}

        {{/if}}

        {{>_msg}}

        {{{body}}}

    </div>

</body>

<script src="/js/bootstrap.js"></script>

</html>

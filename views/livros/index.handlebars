<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1>Biblioteca</h1><p class="text-muted">Compartilhe a capa de um livro, seu comentário e sua nota.</p></div>
    {{#if user}}<a href="/livros/novo" class="btn btn-success">Publicar resenha</a>{{else}}<a href="/usuarios/login" class="btn btn-outline-primary">Entrar para publicar</a>{{/if}}
</div>
<div class="row g-4">
    {{#each livros}}
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            {{#if capa}}<img src="{{capa}}" class="card-img-top" alt="Capa de {{titulo}}" style="height:260px;object-fit:contain;padding:12px">{{/if}}
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{titulo}}</h5>
                <p class="text-muted mb-2">{{autor}}</p>
                {{#if genero}}<span class="badge text-bg-light align-self-start mb-2">{{genero}}</span>{{/if}}
                <p class="mb-3">Nota média: <strong>{{media}}</strong> ({{totalAvaliacoes}} avaliações)</p>
                <a href="/livros/{{_id}}" class="btn btn-primary mt-auto" style="background-color: #cf9191; border-color: #923367; color: white;">Ver livro</a>
                {{#if meu}}<a href="/livros/{{_id}}/editar" class="btn btn-outline-secondary mt-2">Editar minha resenha</a>{{/if}}
            </div>
        </div>
    </div>
    {{else}}
    <p>Ainda não há livros cadastrados.</p>
    {{/each}}
</div>

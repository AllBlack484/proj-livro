{{!-- Banner de boas-vindas (hero): as ilustrações laterais são adicionadas pelo CSS --}}
<section class="hero-libris">
    <div class="hero-conteudo">
        <span class="sobretitulo">Seu próximo capítulo começa aqui</span>
        <h1>Encontre sua <em>próxima história.</em></h1>
        <p>Descubra livros, leia avaliações e compartilhe suas resenhas com outros leitores.</p>
        <a href="#biblioteca" class="btn btn-primary btn-seta">Explorar livros</a>
    </div>
</section>

<div class="cabecalho-secao" id="biblioteca">
    <div><span class="sobretitulo">Escolhidos para você</span><h1>Biblioteca</h1><p class="text-muted">Compartilhe a capa de um livro, seu comentário e sua nota.</p></div>
    {{#if user}}<a href="/livros/novo" class="btn btn-success">Publicar resenha</a>{{else}}<a href="/usuarios/login" class="btn btn-outline-primary">Entrar para publicar</a>{{/if}}
</div>
<div class="row g-4 lista-livros">
    {{#each livros}}
    <div class="col-md-6 col-lg-4">
        <div class="card card-livro h-100 shadow-sm">
            {{#if capa}}<img src="{{capa}}" class="card-img-top capa-livro" alt="Capa de {{titulo}}">{{/if}}
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{titulo}}</h5>
                <p class="text-muted mb-2">{{autor}}</p>
                {{#if genero}}<span class="badge text-bg-light align-self-start mb-2">{{genero}}</span>{{/if}}
                <p class="mb-3 nota-card">Nota média: <strong>{{media}}</strong> ({{totalAvaliacoes}} avaliações)</p>
                <a href="/livros/{{_id}}" class="btn btn-primary mt-auto">Ver livro</a>
                {{#if meu}}<a href="/livros/{{_id}}/editar" class="btn btn-outline-secondary mt-2">Editar minha resenha</a>{{/if}}
            </div>
        </div>
    </div>
    {{else}}
    <p class="estado-vazio">Ainda não há livros cadastrados.</p>
    {{/each}}
</div>

{{!-- Faixa decorativa inspirada na referência visual --}}
<section class="faixa-sentimentos">
    <img src="/img/livro-estrelas.webp" alt="" aria-hidden="true">
    <div>
        <span class="sobretitulo">Cada leitura é única</span>
        <h2>Uma história, mil sentimentos.</h2>
        <p>Deixe sua nota, escreva o que achou e descubra o que outros leitores sentiram ao virar a última página.</p>
    </div>
</section>

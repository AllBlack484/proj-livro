<h1>Minha conta</h1>
<form method="POST" action="/usuarios/conta/edit" class="col-lg-8 cartao-form">
    <label class="form-label">Nome</label><input class="form-control mb-3" name="nome" value="{{user.nome}}" required>
    <label class="form-label">E-mail</label><input class="form-control mb-3" type="email" name="email" value="{{user.email}}" required>
    <label class="form-label">CEP</label><input class="form-control mb-3" name="cep" value="{{user.cep}}" required>
    <label class="form-label">Endereço</label><input class="form-control mb-3" name="logradouro" value="{{user.logradouro}}" required>
    <label class="form-label">Complemento</label><input class="form-control mb-3" name="complemento" value="{{user.complemento}}">
    <label class="form-label">Bairro</label><input class="form-control mb-3" name="bairro" value="{{user.bairro}}" required>
    <label class="form-label">Cidade</label><input class="form-control mb-3" name="localidade" value="{{user.localidade}}" required>
    <label class="form-label">UF</label><input class="form-control mb-3" name="uf" value="{{user.uf}}" required>
    <label class="form-label">Número</label><input class="form-control mb-3" name="numero" value="{{user.numero}}" required>
    <button class="btn btn-success" type="submit">Salvar alterações</button>
</form>
